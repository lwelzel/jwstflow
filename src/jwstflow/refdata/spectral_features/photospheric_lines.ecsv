# %ECSV 1.0
# ---
# datatype:
# - {name: id, datatype: string, description: stable identifier used in configs}
# - {name: label, datatype: string}
# - {name: species, datatype: string}
# - {name: kind, datatype: string, description: 'line: narrow feature (edges = +/- width); band: broad feature (edges as given)'}
# - {name: wavelength_um, unit: um, datatype: float64, description: central (vacuum) wavelength; NaN for bands with no single centre}
# - {name: wave_min_um, unit: um, datatype: float64, description: lower edge used when masking/selecting the feature}
# - {name: wave_max_um, unit: um, datatype: float64, description: upper edge used when masking/selecting the feature}
# - {name: transition, datatype: string}
# - {name: source, datatype: string}
# - {name: notes, datatype: string}
# meta: !!omap
# - {dataset: photospheric_lines}
# - {description: 'Absorption lines and molecular bandheads of late-type (K/M) stellar photospheres in the near-infrared (0.85-4.1 um),
#     as seen in the spectra of young stars and in the starlight scattered by their disks'}
# - {version: 2026.11.1}
# - {provenance: 'Atomic lines: NIST ASD Ritz vacuum wavelengths of the strongest transition of each blend; CO bandheads: heads of the
#     R branches in HITRAN2020; SiO bandheads as commonly quoted (approximate). Regenerated by scripts/build_line_tables.py.'}
# - references: ['Wallace & Hinkle 1996, ApJS 107, 312 and 1997, ApJS 111, 445 (K band atlas)', 'Meyer et al. 1998, ApJ 508, 397 (H band)',
#     'Cushing, Rayner & Vacca 2005, ApJ 623, 1115 and Rayner, Cushing & Vacca 2009, ApJS 185, 289 (IRTF spectral library)', NIST ASD
#       (Kramida et al.); atomic lines, 'Goorvitch 1994, ApJS 95, 535 (CO bandheads)']
# - {notes: 'An opt-in dataset: it is not part of a bare `features: all` (so it never changes what data steps mask); QA figures annotate
#     it in its own row and color. Select it with `features: {photospheric_lines: all}`.'}
# - {usage: 'Select in a workflow with `features: {photospheric_lines: all | [ids or species]}`.'}
# schema: astropy-2.0
id label species kind wavelength_um wave_min_um wave_max_um transition source notes
